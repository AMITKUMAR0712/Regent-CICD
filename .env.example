# Copy to .env (local dev) or configure these as real secrets in your hosting
# provider for production. Never commit an actual .env file.

# --- Database (MySQL 8) ---------------------------------------------------
DATABASE_URL="mysql://party_app:party_app_password@localhost:3308/party_space_booking"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- App -------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- AWS SES (transactional email) -----------------------------------------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_EMAIL="no-reply@example.com"

# --- AWS S3 (private file storage) -----------------------------------------
AWS_S3_BUCKET=""
# Reuses AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above.

# --- Razorpay ----------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- MSG91 (phone OTP only) -------------------------------------------------
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# --- Cron / internal job auth ------------------------------------------------
# Shared secret required in the Authorization header of every /api/cron/* call.
CRON_SECRET=""

# --- Gmail SMTP (temporary email sender until Phase 3's SES-based
# NotificationProvider lands) -------------------------------------------
# App password, not your normal Gmail password: Google Account > Security >
# 2-Step Verification > App passwords.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
CONTACT_RECEIVER_EMAIL=""
