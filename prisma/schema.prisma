// Party space booking platform — data model.
// See PROJECT_SPEC.md section 8. Every field used in a WHERE/ORDER BY has an index.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  HOST
  ADMIN
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum IdType {
  DRIVING_LICENCE
  PASSPORT
  VOTER_ID
}

enum PropertyType {
  FLAT
  PG_ROOM
  ROOM
  TERRACE
  FARMHOUSE
  BANQUET
}

enum PropertyStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
}

enum GuestDetailLevel {
  COUNT_ONLY
  NAME_PHONE
  FULL_ID
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentPurpose {
  SUBSCRIPTION
  UNLOCK
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RuleCategory {
  MUSIC
  ALCOHOL
  SMOKING
  TIMING
  GUESTS
  SAFETY
  OTHER
}

enum NotifyChannel {
  EMAIL
  IN_APP
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DROPPED
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Identity & KYC
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  emailVerifiedAt  DateTime?
  phone            String     @unique
  phoneVerifiedAt  DateTime?
  name             String
  dateOfBirth      DateTime
  city             String
  role             Role
  kycStatus        KycStatus  @default(NOT_SUBMITTED)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  kycProfile           KycProfile?        @relation("KycOwner")
  kycProfilesReviewed  KycProfile[]       @relation("KycReviewer")
  properties           Property[]         @relation("PropertyOwner")
  subscriptions        Subscription[]     @relation("SubscriptionOwner")
  partyRequests        PartyRequest[]     @relation("PartyRequestHost")
  contactUnlocks       ContactUnlock[]    @relation("ContactUnlockHost")
  payments             Payment[]          @relation("PaymentUser")
  notifications        InAppNotification[] @relation("NotificationUser")
  notificationLogs     NotificationLog[]  @relation("NotificationLogUser")
  reviewsWritten       Review[]           @relation("ReviewAuthor")
  reportsFiled         Report[]           @relation("ReportReporter")
  reportsResolved      Report[]           @relation("ReportResolver")
  auditLogs            AuditLog[]         @relation("AuditActor")
  verificationTokens   VerificationToken[]

  @@index([role])
  @@index([kycStatus])
}

model VerificationToken {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String                 @unique
  type       VerificationTokenType
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime               @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model KycProfile {
  id                     String     @id @default(cuid())
  userId                 String     @unique
  user                   User       @relation("KycOwner", fields: [userId], references: [id], onDelete: Cascade)

  idType                 IdType
  idLastFour             String
  idFileKey              String
  selfieFileKey          String
  addressLine            String
  pincode                String

  // Owner-only
  ownershipProofFileKey  String?

  // Host-only
  emergencyContactName   String?
  emergencyContactPhone  String?

  // Optional, both roles
  alternatePhone         String?

  status                 KycStatus  @default(PENDING)
  reviewedById           String?
  reviewedBy             User?      @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewNote             String?
  reviewedAt             DateTime?

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([status])
  @@index([reviewedById])
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

model Property {
  id                         String          @id @default(cuid())
  ownerId                    String
  owner                      User            @relation("PropertyOwner", fields: [ownerId], references: [id])

  title                      String
  slug                       String          @unique
  type                       PropertyType
  description                String          @db.Text
  city                       String
  locality                   String
  addressLine                String
  pincode                    String
  lat                        Float
  lng                        Float
  maxGuests                  Int
  basePricePaise             Int
  perHeadPricePaise          Int
  guestDetailLevel           GuestDetailLevel @default(NAME_PHONE)
  societyPermissionRequired  Boolean         @default(false)
  musicCutoffTime            String          @default("23:00")
  status                     PropertyStatus  @default(DRAFT)
  rejectionReason            String?
  verifiedAt                 DateTime?
  completedParties           Int             @default(0)

  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  images                     PropertyImage[]
  rules                      PropertyRule[]
  blockedDates               BlockedDate[]
  partyRequests              PartyRequest[]
  reports                    Report[]

  @@index([city, status])
  @@index([status, createdAt])
  @@index([ownerId])
}

model PropertyImage {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fileKey     String
  sortOrder   Int       @default(0)
  isCover     Boolean   @default(false)
  width       Int
  height      Int

  @@index([propertyId])
}

model HouseRule {
  id         String         @id @default(cuid())
  code       String         @unique
  label      String
  category   RuleCategory
  sortOrder  Int            @default(0)

  propertyRules  PropertyRule[]

  @@index([category])
}

model PropertyRule {
  id           String     @id @default(cuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  houseRuleId  String
  houseRule    HouseRule  @relation(fields: [houseRuleId], references: [id])
  allowed      Boolean
  note         String?

  @@unique([propertyId, houseRuleId])
  @@index([propertyId])
  @@index([houseRuleId])
}

model BlockedDate {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date        DateTime

  @@unique([propertyId, date])
  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Party requests & guests
// ---------------------------------------------------------------------------

model PartyRequest {
  id                  String            @id @default(cuid())
  code                String            @unique
  propertyId          String
  property            Property          @relation(fields: [propertyId], references: [id])
  hostId              String
  host                User              @relation("PartyRequestHost", fields: [hostId], references: [id])

  eventDate           DateTime
  startTime           String
  endTime             String
  guestCount          Int
  finalGuestCount     Int?
  perHeadBudgetPaise  Int
  occasion            String
  notes               String?           @db.Text

  status              RequestStatus     @default(PENDING)

  rulesSnapshot       Json
  rulesAcceptedAt     DateTime
  guestDetailLevel    GuestDetailLevel

  guestListToken      String            @unique
  guestListLockedAt   DateTime?

  ownerRespondedAt    DateTime?
  rejectionReason     String?
  expiresAt           DateTime

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  guests              PartyGuest[]
  contactUnlock       ContactUnlock?
  review              Review?

  @@index([propertyId, status])
  @@index([hostId, status])
  @@index([eventDate])
  @@index([status])
  @@index([expiresAt])
}

model PartyGuest {
  id               String        @id @default(cuid())
  partyRequestId   String
  partyRequest     PartyRequest  @relation(fields: [partyRequestId], references: [id], onDelete: Cascade)

  name             String?
  phone            String?
  idType           IdType?
  idLastFour       String?
  idFileKey        String?

  selfCheckedInAt  DateTime?
  purgeAfter       DateTime
  createdAt        DateTime      @default(now())

  @@index([partyRequestId])
  @@index([purgeAfter])
}

model ContactUnlock {
  id              String        @id @default(cuid())
  partyRequestId  String        @unique
  partyRequest    PartyRequest  @relation(fields: [partyRequestId], references: [id])
  hostId          String
  host            User          @relation("ContactUnlockHost", fields: [hostId], references: [id])
  paymentId       String        @unique
  payment         Payment       @relation(fields: [paymentId], references: [id])
  unlockedAt      DateTime      @default(now())

  @@index([hostId])
}

// ---------------------------------------------------------------------------
// Subscriptions & payments
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  listingLimit    Int
  durationMonths  Int
  pricePaise      Int
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)

  subscriptions   Subscription[]

  @@index([isActive])
}

model Subscription {
  id                      String            @id @default(cuid())
  ownerId                 String
  owner                   User              @relation("SubscriptionOwner", fields: [ownerId], references: [id])
  planId                  String
  plan                    SubscriptionPlan  @relation(fields: [planId], references: [id])
  startsAt                DateTime
  endsAt                  DateTime
  status                  SubStatus         @default(ACTIVE)
  razorpaySubscriptionId  String?           @unique

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([ownerId, status])
  @@index([endsAt])
}

model Payment {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation("PaymentUser", fields: [userId], references: [id])
  purpose            PaymentPurpose
  amountPaise        Int
  razorpayOrderId    String?         @unique
  razorpayPaymentId  String?         @unique
  razorpaySignature  String?
  status             PaymentStatus   @default(CREATED)
  meta               Json?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  contactUnlock      ContactUnlock?

  @@index([userId, status])
  @@index([purpose, status])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model InAppNotification {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("NotificationUser", fields: [userId], references: [id])
  templateKey  String
  title        String
  body         String     @db.Text
  linkUrl      String?
  readAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model NotificationLog {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation("NotificationLogUser", fields: [userId], references: [id])
  channel            NotifyChannel
  templateKey        String
  payload            Json
  status             String
  providerMessageId  String?
  error              String?
  sentAt             DateTime?
  createdAt          DateTime       @default(now())

  @@index([userId])
  @@index([templateKey])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Trust & safety, growth
// ---------------------------------------------------------------------------

model Review {
  id              String        @id @default(cuid())
  partyRequestId  String        @unique
  partyRequest    PartyRequest  @relation(fields: [partyRequestId], references: [id])
  byUserId        String
  byUser          User          @relation("ReviewAuthor", fields: [byUserId], references: [id])
  rating          Int
  comment         String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([byUserId])
}

model Report {
  id            String        @id @default(cuid())
  reporterId    String
  reporter      User          @relation("ReportReporter", fields: [reporterId], references: [id])
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id])
  reason        String
  details       String?       @db.Text
  status        ReportStatus  @default(OPEN)
  resolvedById  String?
  resolvedBy    User?         @relation("ReportResolver", fields: [resolvedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([propertyId])
  @@index([status])
}

model AdLead {
  id        String      @id @default(cuid())
  source    String
  campaign  String?
  name      String
  phone     String
  email     String?
  city      String?
  intent    String?
  status    LeadStatus  @default(NEW)
  notes     String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([status])
  @@index([source])
}

model AuditLog {
  id        String    @id @default(cuid())
  actorId   String?
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum HeroMediaType {
  IMAGE
  VIDEO
}

// Admin-managed background media for the night-surface hero (home page).
// One item loops; two or more become a swipeable, auto-advancing slideshow.
// Files live on local disk for now (see src/lib/hero-media-storage.ts) —
// swap for S3 once Phase 1's presigned-upload infra lands, same pattern as
// src/lib/mail.ts standing in for the real notification pipeline.
model HeroMedia {
  id        String        @id @default(cuid())
  type      HeroMediaType
  url       String
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@index([isActive, sortOrder])
}
